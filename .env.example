# Copy to .env.local for local development. Never commit real values.
# Admin login (user supplies these in Vercel)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Use at least 32 random characters; all session verification fails closed otherwise.
SERVER_SESSION_SECRET=

# Election View shared password (user supplies in Vercel)
STAFF_PASSWORD=

# Firebase Admin SDK (server-side; set after Firebase project setup)
FIREBASE_SERVICE_ACCOUNT=

# Firestore is accessed only by server APIs using Firebase Admin SDK.
# Browser clients do not connect directly; deny-all Firestore rules are supported.

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
