# Copy to .env.local for local development. Never commit real values.
# Admin login (user supplies these in Vercel)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Use at least 32 random characters; all session verification fails closed otherwise.
SERVER_SESSION_SECRET=

# Election View shared password (user supplies in Vercel)
STAFF_PASSWORD=

# Firebase Admin SDK (server-side; set after Firebase project setup)
FIREBASE_SERVICE_ACCOUNT=

# Firebase web app (client-side; set after Firebase project setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
